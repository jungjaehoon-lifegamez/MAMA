{
  "name": "mama",
  "version": "2.2.0",
  "description": "Memory-Augmented MCP Assistant - Chat from anywhere, track decisions, never repeat mistakes.",
  "author": {
    "name": "SpineLift Team",
    "email": "dev@spinelift.com"
  },
  "license": "MIT",
  "repository": "https://github.com/jungjaehoon-lifegamez/MAMA",
  "homepage": "https://github.com/jungjaehoon-lifegamez/MAMA#readme",
  "keywords": [
    "claude-code",
    "memory-assistant",
    "decision-tracking",
    "mcp-server",
    "semantic-search"
  ],
  "commands": [
    "./commands/decision.md",
    "./commands/search.md",
    "./commands/checkpoint.md",
    "./commands/resume.md",
    "./commands/configure.md"
  ],
  "skills": ["./skills/mama-context", "./skills/mama-install"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NODE_PATH=\"${CLAUDE_PLUGIN_DATA}/node_modules\" node \"${CLAUDE_PLUGIN_ROOT}/scripts/sessionstart-hook.js\"",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "mama": {
      "command": "npx",
      "args": ["-y", "@jungjaehoon/mama-server"]
    }
  }
}
