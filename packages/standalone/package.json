{
  "name": "@jungjaehoon/mama-os",
  "version": "0.70.0",
  "description": "MAMA OS - The local work agent behind your messenger.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mama": "./dist/cli/index.js",
    "mama-os": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "pnpm clean && tsc && pnpm run build:viewer && pnpm run build:ui",
    "build:ui": "pnpm --dir ui run bundle",
    "build:viewer": "rm -rf public/viewer/js && tsc -p public/viewer/tsconfig.viewer.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "assistant",
    "claude",
    "mcp",
    "memory",
    "always-on"
  ],
  "author": "Jung Jaehoon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jungjaehoon-lifegamez/MAMA.git",
    "directory": "packages/standalone"
  },
  "bugs": {
    "url": "https://github.com/jungjaehoon-lifegamez/MAMA/issues"
  },
  "homepage": "https://github.com/jungjaehoon-lifegamez/MAMA#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "public",
    "db",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@slack/web-api": "^7.13.0",
    "@slack/socket-mode": "^2.0.5",
    "discord.js": "^14.25.1",
    "@jungjaehoon/mama-core": "workspace:*",
    "better-sqlite3": "^12.8.0",
    "express": "^5.2.1",
    "grammy": "^1.42.0",
    "htmlparser2": "12.0.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
