{
  "name": "@jungjaehoon/mama-core",
  "version": "8.4.0",
  "description": "MAMA Core - Shared modules for Memory-Augmented MCP Assistant",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./embeddings": "./dist/embedding/embedder.js",
    "./memory/types": "./dist/memory/types.js",
    "./db-manager": "./dist/db-manager.js",
    "./mama-api": "./dist/mama-api.js",
    "./relevance-scorer": "./dist/relevance-scorer.js",
    "./debug-logger": "./dist/debug-logger.js",
    "./decision-formatter": "./dist/decision-formatter.js",
    "./errors": "./dist/errors.js",
    "./canonicalize": "./dist/canonicalize.js",
    "./connectors": "./dist/knowledge/event-index.js",
    "./connectors/event-index": "./dist/knowledge/event-index.js",
    "./connectors/raw-query": "./dist/knowledge/raw-query.js",
    "./provenance/source-ref": "./dist/provenance/source-ref.js",
    "./registry/store": "./dist/registry/store.js",
    "./operations/owner-action-effects": "./dist/operations/owner-action-effects.js",
    "./knowledge": "./dist/knowledge/index.js",
    "./action-contracts": "./dist/action-contracts.js",
    "./api/catalog": "./dist/api/catalog.js",
    "./api/dispatch": "./dist/api/dispatch.js",
    "./client/client": "./dist/client/client.js",
    "./client/ipc": "./dist/client/ipc.js",
    "./runtime/*": {
      "types": "./dist/runtime/*.d.ts",
      "default": "./dist/runtime/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules dist"
  },
  "keywords": [
    "mama",
    "memory-assistant",
    "decision-tracking",
    "semantic-search",
    "embeddings",
    "sqlite",
    "mcp"
  ],
  "author": "SpineLift Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jungjaehoon-lifegamez/MAMA.git",
    "directory": "packages/mama-core"
  },
  "bugs": {
    "url": "https://github.com/jungjaehoon-lifegamez/MAMA/issues"
  },
  "homepage": "https://github.com/jungjaehoon-lifegamez/MAMA#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "better-sqlite3": "^12.8.0",
    "js-tiktoken": "^1.0.21",
    "minimatch": "^10.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^1.0.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "db/**/*.sql",
    "README.md",
    "LICENSE"
  ]
}
